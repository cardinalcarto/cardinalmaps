    {
      "name": "places",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"places\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"version\" INTEGER NULL, \"name\" TEXT NULL, \"country_code\" TEXT NULL, \"center_lon\" REAL NOT NULL, \"center_lat\" REAL NOT NULL, \"bbox_west\" REAL NULL, \"bbox_south\" REAL NULL, \"bbox_east\" REAL NULL, \"bbox_north\" REAL NULL, \"shape\" TEXT NULL, \"address\" TEXT NULL, \"admins\" TEXT NULL, \"tags\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"accessed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "saved_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_lists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"parent_id\" INTEGER NULL REFERENCES saved_lists (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"note\" TEXT NULL, \"position\" INTEGER NOT NULL, \"shown_on_map\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shown_on_map\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "saved_places",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_places\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"place_id\" TEXT NOT NULL REFERENCES places (id), \"list_id\" INTEGER NULL REFERENCES saved_lists (id) ON DELETE CASCADE, \"name\" TEXT NULL, \"note\" TEXT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"position\" INTEGER NOT NULL, \"saved_at\" INTEGER NOT NULL, \"emoji\" TEXT NULL, \"shown_on_map\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shown_on_map\" IN (0, 1)));"
        }
      ]
    },
