{
  "version": 8,
  "name": "Circles test",
  "sources": {
    "openmaptiles": {"type": "vector"}
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#f4f1ea"}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
     "paint": {"fill-color": "#a8c8e8"}},
    {"id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
     "paint": {"line-color": "#ffffff",
               "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.5, 16, 6]}},
    {"id": "place", "type": "circle", "source": "openmaptiles", "source-layer": "place",
     "paint": {
       "circle-radius": ["interpolate", ["linear"], ["zoom"], 8, 10, 16, 30],
       "circle-color": "#7a3fb0",
       "circle-opacity": 0.25,
       "circle-blur": 0.5,
       "circle-pitch-alignment": "map",
       "circle-stroke-width": 2,
       "circle-stroke-color": "#7a3fb0",
       "circle-stroke-opacity": 0.6
     }},
    {"id": "poi-shadow", "type": "circle", "source": "openmaptiles", "source-layer": "poi",
     "filter": ["<=", ["get", "rank"], 10],
     "paint": {
       "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, ["/", 12, ["get", "rank"]], 16, ["/", 40, ["get", "rank"]]],
       "circle-color": "#000000",
       "circle-opacity": 0.4,
       "circle-blur": 0.4,
       "circle-translate": [4, 4],
       "circle-translate-anchor": "viewport"
     }},
    {"id": "poi", "type": "circle", "source": "openmaptiles", "source-layer": "poi",
     "filter": ["<=", ["get", "rank"], 10],
     "layout": {"circle-sort-key": ["-", ["get", "rank"]]},
     "paint": {
       "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, ["/", 12, ["get", "rank"]], 16, ["/", 40, ["get", "rank"]]],
       "circle-color": ["match", ["get", "class"],
         ["restaurant", "fast_food", "cafe", "bar", "beer"], "#e8590c",
         ["shop", "grocery", "clothing_store"], "#1c7ed6",
         ["park", "garden"], "#2f9e44",
         "#868e96"],
       "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 2],
       "circle-stroke-color": "#ffffff"
     }}
  ]
}
