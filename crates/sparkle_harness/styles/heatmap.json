{
  "version": 8,
  "name": "Heatmap test",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://seattle.mbtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#f2efe9"}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "#b5cde0"}
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary"], true, false],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 8, 0.5, 16, 6]
      }
    },
    {
      "id": "poi-heat",
      "type": "heatmap",
      "source": "openmaptiles",
      "source-layer": "poi",
      "maxzoom": 18,
      "paint": {
        "heatmap-weight": ["interpolate", ["linear"], ["coalesce", ["get", "rank"], 30], 1, 1, 30, 0.2],
        "heatmap-intensity": ["interpolate", ["linear"], ["zoom"], 12, 0.3, 16, 1],
        "heatmap-color": [
          "interpolate", ["linear"], ["heatmap-density"],
          0, "rgba(33, 102, 172, 0)",
          0.2, "rgb(103, 169, 207)",
          0.4, "rgb(209, 229, 240)",
          0.6, "rgb(253, 219, 199)",
          0.8, "rgb(239, 138, 98)",
          1, "rgb(178, 24, 43)"
        ],
        "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 12, 8, 16, 30],
        "heatmap-opacity": ["interpolate", ["linear"], ["zoom"], 15, 0.9, 18, 0.3]
      }
    }
  ]
}
