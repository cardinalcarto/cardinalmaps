# valinor-server, the router behind Cardinal's /routing/ (see
# k8s/cardinal/routing/). Build it from this directory:
#
#   podman build -f Containerfile -t cardinal-valinor .
#
# It serves Valhalla's API at its root on --listen (0.0.0.0:8002 by default),
# with the tiles and valhalla.json that the data pipeline's RoutingTiles builds:
#
#   podman run --rm -p 8002:8002 -v ./routing:/routing:ro,z cardinal-valinor \
#     --config /routing/valhalla.json --tiles /routing/tiles.tar
FROM docker.io/library/rust:1.98-trixie AS build

WORKDIR /src
COPY . .
RUN cargo build --release --locked -p valinor-server

FROM docker.io/library/debian:trixie-slim

COPY --from=build /src/target/release/valinor-server /usr/local/bin/valinor-server

USER 65534:65534
EXPOSE 8002
ENV RUST_LOG=info
ENTRYPOINT ["valinor-server"]
