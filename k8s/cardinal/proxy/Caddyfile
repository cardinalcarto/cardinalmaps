{
	admin off
	auto_https off
	persist_config off
	servers {
		# Pass on the Tailscale proxy's X-Forwarded-* headers, which Martin
		# uses for the public tile URLs in its TileJSON.
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Geocoder results and routes carry shapes, which compress well. Tiles are already
	# compressed, and Caddy leaves responses with an encoding alone.
	encode zstd gzip
	handle /tiles/* {
		reverse_proxy martin:80
	}
	handle_path /geocoder/* {
		reverse_proxy geocoder:80
	}
	# Valinor serves Valhalla's API (/route, /locate, /status, ...) at its root.
	handle_path /routing/* {
		reverse_proxy routing:80
	}
	handle {
		respond 404
	}
}
